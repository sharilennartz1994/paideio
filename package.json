{
  "name": "paideio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx src/lib/db/seed.ts",
    "test:capienza": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-capienza.mts",
    "test:chiusure": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-chiusure.mts",
    "db:constraints": "dotenv -e .env.local -- tsx --tsconfig tsconfig.scripts.json scripts/db-apply-overlap-constraint.mts",
    "db:local:up": "docker compose up -d db && docker compose exec -T db sh -c 'until pg_isready -U postgres -d paideio >/dev/null 2>&1; do sleep 1; done' && echo 'Postgres locale pronto su localhost:55433'",
    "db:local:down": "docker compose down",
    "db:local:reset": "dotenv -e .env.development.local -- sh -c 'drizzle-kit push --force && tsx --tsconfig tsconfig.scripts.json scripts/db-apply-overlap-constraint.mts && tsx src/lib/db/seed.ts'",
    "test:identita": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-identita.mts",
    "test:email": "tsx --tsconfig tsconfig.scripts.json scripts/test-email-prenotazione.mts",
    "test:recensioni": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-recensioni.mts",
    "test:proposte": "tsx --tsconfig tsconfig.scripts.json scripts/e2e-proposte.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/localizations": "^4.13.4",
    "@clerk/nextjs": "^7.5.19",
    "@clerk/ui": "^1.25.4",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.5",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "bufferutil@4.1.0": true,
    "core-js@3.47.0": true,
    "utf-8-validate@6.0.6": true
  }
}
